# Environment Variables for BLA Task Management Frontend
# ============================================================
# NOTE: Ports vary depending on the execution environment
# ============================================================

# For local development (Visual Studio / VS Code):
# VITE_TASKS_API_URL=http://localhost:5077/api
# VITE_USERS_API_URL=http://localhost:5034/api

# For Docker (Recommended):
VITE_TASKS_API_URL=http://localhost:5001/api
VITE_USERS_API_URL=http://localhost:5002/api

# App Configuration
VITE_APP_ENV=development
VITE_APP_NAME=BLA Task Management System
