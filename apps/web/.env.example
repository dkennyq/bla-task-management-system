# Environment Variables for BLA Task Management Frontend
# ============================================================
# NOTA: Los puertos varían según el entorno de ejecución
# ============================================================

# Para desarrollo local (Visual Studio / VS Code):
# VITE_TASKS_API_URL=http://localhost:5077
# VITE_USERS_API_URL=http://localhost:5034

# Para Docker (Recomendado):
VITE_TASKS_API_URL=http://localhost:5001
VITE_USERS_API_URL=http://localhost:5002

# App Configuration
VITE_APP_ENV=development
VITE_APP_NAME=BLA Task Management System
