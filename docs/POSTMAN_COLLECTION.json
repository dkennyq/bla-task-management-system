{
  "info": {
    "name": "BLA Task Management System",
    "description": "Collection for Tasks API and Users API testing",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Users API",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"johndoe\",\n  \"fullName\": \"John Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "http://localhost:5078/api/users/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5078",
              "path": ["api", "users", "register"]
            },
            "description": "Register a new user. Returns JWT access token + refresh token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "",
                  "if (response.token) {",
                  "    pm.collectionVariables.set(\"jwt_token\", response.token);",
                  "    console.log(\"✅ jwt_token saved:\", response.token.substring(0, 30) + \"...\");",
                  "} else {",
                  "    console.error(\"there is no token in the response.\");",
                  "}",
                  "",
                  "if (response.refreshToken) {",
                  "    pm.collectionVariables.set(\"refresh_token\", response.refreshToken);",
                  "    console.log(\"✅ refresh_token saved\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "http://localhost:5078/api/users/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5078",
              "path": ["api", "users", "login"]
            },
            "description": "Login with email/password. Returns token, refreshToken, expiresAt, userId, email, fullName."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "",
                  "if (response.token) {",
                  "    pm.collectionVariables.set(\"jwt_token\", response.token);",
                  "    console.log(\"✅ jwt_token saved:\", response.token.substring(0, 30) + \"...\");",
                  "} else {",
                  "    console.error(\"there is no token in the response.\");",
                  "}",
                  "",
                  "if (response.refreshToken) {",
                  "    pm.collectionVariables.set(\"refresh_token\", response.refreshToken);",
                  "    console.log(\"✅ refresh_token saved\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "http://localhost:5078/api/users/refresh",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5078",
              "path": ["api", "users", "refresh"]
            },
            "description": "Exchange a refresh token for a new JWT access token + new refresh token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "",
                  "if (response.token) {",
                  "    pm.collectionVariables.set(\"jwt_token\", response.token);",
                  "    console.log(\"✅ jwt_token saved:\", response.token.substring(0, 30) + \"...\");",
                  "} else {",
                  "    console.error(\"there is no token in the response.\");",
                  "}",
                  "",
                  "if (response.refreshToken) {",
                  "    pm.collectionVariables.set(\"refresh_token\", response.refreshToken);",
                  "    console.log(\"✅ refresh_token saved\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get Current User (Me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:5078/api/users/me",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5078",
              "path": ["api", "users", "me"]
            },
            "description": "Get current authenticated user's info from JWT claims."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Tasks API",
      "item": [
        {
          "name": "Get All Tasks",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:5077/api/tasks",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5077",
              "path": ["api", "tasks"]
            },
            "description": "Get all tasks for the authenticated user. UserId extracted from JWT."
          },
          "response": []
        },
        {
          "name": "Get Task By Id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:5077/api/tasks/{{taskId}}",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5077",
              "path": ["api", "tasks", "{{taskId}}"]
            },
            "description": "Get a specific task by ID. Must be owned by the authenticated user."
          },
          "response": []
        },
        {
          "name": "Create Task",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Implement User Authentication\",\n  \"description\": \"Create JWT-based authentication system\",\n  \"priority\": \"High\",\n  \"dueDate\": \"2026-06-15T23:59:59Z\"\n}"
            },
            "url": {
              "raw": "http://localhost:5077/api/tasks",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5077",
              "path": ["api", "tasks"]
            },
            "description": "Create a new task. UserId extracted from JWT. Status defaults to Pending."
          },
          "response": []
        },
        {
          "name": "Update Task",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Implement User Authentication\",\n  \"description\": \"Create JWT-based authentication system with refresh tokens\",\n  \"status\": \"InProgress\",\n  \"priority\": \"High\",\n  \"dueDate\": \"2026-06-20T23:59:59Z\"\n}"
            },
            "url": {
              "raw": "http://localhost:5077/api/tasks/{{taskId}}",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5077",
              "path": ["api", "tasks", "{{taskId}}"]
            },
            "description": "Update an existing task. Must be owned by the authenticated user."
          },
          "response": []
        },
        {
          "name": "Delete Task",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:5077/api/tasks/{{taskId}}",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5077",
              "path": ["api", "tasks", "{{taskId}}"]
            },
            "description": "Delete a task. Must be owned by the authenticated user."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "userId",
      "value": "00000000-0000-0000-0000-000000000001",
      "type": "string"
    },
    {
      "key": "taskId",
      "value": "",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    }
  ]
}
