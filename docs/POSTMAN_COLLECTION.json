              "raw": "http://localhost:5077/api/tasks?userId={{userId}}",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5077",
              "path": ["api", "tasks"],
              "query": [
                {
                  "key": "userId",
                  "value": "{{userId}}",
                  "description": "User GUID"
                }
              ]
            },
            "description": "Get all tasks for a specific user (US-01)"
          },
          "response": []
        },
        {
          "name": "Get Task By Id",
